PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Leave DATABASE_URL empty locally: an embedded Postgres is used (./.pgdata).
# On Render it is filled in automatically by render.yaml.
DATABASE_URL=
# First admin account, created on startup if it does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Optional: leave empty and the AI page shows "coming soon"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cloudflare R2 image storage (optional: leave empty to store photos in Postgres)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: public domain of the bucket (custom domain or r2.dev). Empty = photos stream through the API.
R2_PUBLIC_URL=

# Encrypts BVN and ID numbers in the database. Keep it secret and never change it once KYC data exists.
KYC_ENCRYPTION_KEY=
# Forgot-password emails via Resend (resend.com). Without these, reset links are only printed in the server log.
RESEND_API_KEY=
MAIL_FROM=AgriConnect <noreply@your-domain.com>
# Shown to investors after they start an investment (bank name, account number, account name)
PAYMENT_INSTRUCTIONS=

# Investments stay disabled ("coming soon") until you connect a payment provider such as Stripe.
# true = allow manual bank-transfer investments confirmed by an admin (see README).
PAYMENTS_ENABLED=false
